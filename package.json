{
  "name": "codacy-spectral",
  "description": "Spectral Tool for Codacy",
  "keywords": [
    "codacy",
    "spectral",
    "yamlLinter",
    "jsonLinter",
    "yaml",
    "json",
    "linter",
    "typescript"
  ],
  "homepage": "https://github.com/codacy/codacy-spectral#readme",
  "bugs": {
    "url": "https://github.com/codacy/codacy-spectral/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codacy/codacy-spectral.git"
  },
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "directories": {
    "test": "./src/test",
    "src": "./src",
    "doc-generator": "./doc-generator"
  },
  "scripts": {
    "compile": "tsc",
    "start": "node dist/index.js",
    "test": "mocha",
    "dockerBuild": "docker build -t codacy-spectral ."
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "package.json": [
      "npm run generateDocs",
      "sort-package-json",
      "git add"
    ],
    "src/*.{ts,js,css,json,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "prettier": {
    "semi": false
  },
  "mocha": {
    "extension": [
      "ts"
    ],
    "require": "ts-node/register",
    "spec": "src/test/**/*.spec.ts"
  },
  "dependencies": {
    "@eslint/config-array": "0.23.6",
    "@eslint/eslintrc": "3.3.7",
    "@stoplight/spectral-core": "1.24.1",
    "@stoplight/spectral-formats": "1.9.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-ruleset-migrator": "1.13.0",
    "@stoplight/spectral-rulesets": "1.23.1",
    "@stoplight/types": "14.1.1",
    "@types/glob": "9.0.0",
    "@types/lodash": "4.17.27",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/node-fetch": "2.6.13",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/typescript-estree": "8.73.0",
    "axios": "1.21.1",
    "chai": "6.3.0",
    "codacy-seed": "2.2.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "glob": "14.0.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "lodash": "4.18.1",
    "minimatch": "11.0.9",
    "mocha": "12.0.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
